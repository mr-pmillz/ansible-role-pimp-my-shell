# Role settings are updated inside this block. Keep personal additions outside it.
{% set oh_my_zsh = (user | default({})).oh_my_zsh | default({}) %}

# Preserve a custom installation path and aliases already defined by the user.
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
typeset -A _pimp_my_shell_saved_aliases
_pimp_my_shell_saved_aliases=("${(@kv)aliases}")

# Keep custom themes (including an explicitly empty theme). Replace only an
# unset theme or Oh My Zsh's stock default with the configured role theme.
_pimp_my_shell_set_theme=false
if [[ -z "${ZSH_THEME+x}" || "$ZSH_THEME" == robbyrussell ]]; then
  ZSH_THEME={{ oh_my_zsh.theme | default(oh_my_zsh_theme) | quote }}
  _pimp_my_shell_set_theme=true
fi

# Add the role's plugins without dropping the user's list or loading it twice.
typeset -ga plugins
typeset -aU _pimp_my_shell_new_plugins
_pimp_my_shell_new_plugins=()
for _pimp_my_shell_plugin in {{ oh_my_zsh.plugins | default(oh_my_zsh_plugins) | map('quote') | join(' ') }}; do
  if (( ! ${plugins[(Ie)$_pimp_my_shell_plugin]} )); then
    _pimp_my_shell_new_plugins+=("$_pimp_my_shell_plugin")
  fi
done

if (( $+functions[omz] )); then
  # An existing .zshrc may already have initialized Oh My Zsh.
  if (( $#_pimp_my_shell_new_plugins )); then
    omz plugin load "${_pimp_my_shell_new_plugins[@]}"
  fi
  if [[ "$_pimp_my_shell_set_theme" == true && -n "$ZSH_THEME" ]]; then
    omz theme use "$ZSH_THEME"
  fi
  plugins+=("${_pimp_my_shell_new_plugins[@]}")
else
  plugins+=("${_pimp_my_shell_new_plugins[@]}")
  if [[ "$ZSH_THEME" == powerlevel10k/powerlevel10k ]]; then
{{ prepend_data | indent(4, true) }}
  fi
  # Supply update defaults only when the user has not configured them.
  zstyle -s ':omz:update' mode _pimp_my_shell_update || \
    zstyle ':omz:update' mode {{ oh_my_zsh.update_mode | default(oh_my_zsh_update_mode) | quote }}
  zstyle -s ':omz:update' frequency _pimp_my_shell_update || \
    zstyle ':omz:update' frequency {{ oh_my_zsh.update_frequency | default(oh_my_zsh_update_frequency) | quote }}
  source "$ZSH/oh-my-zsh.sh"
fi

# User aliases win over aliases introduced by Oh My Zsh and the added plugins.
for _pimp_my_shell_alias in "${(@k)_pimp_my_shell_saved_aliases}"; do
  alias -- "$_pimp_my_shell_alias=${_pimp_my_shell_saved_aliases[$_pimp_my_shell_alias]}"
done
unset _pimp_my_shell_saved_aliases _pimp_my_shell_new_plugins
unset _pimp_my_shell_alias _pimp_my_shell_plugin _pimp_my_shell_set_theme _pimp_my_shell_update

{{ append_data }}
